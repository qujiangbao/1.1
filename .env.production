# ══════════════════════════════════════════════
# Industrial Park Agent v1.2 — Production Config
# ══════════════════════════════════════════════

# Environment
APP_ENV=production
LOG_LEVEL=INFO

# Database (P5: Alembic-managed)
DATABASE_URL=postgresql+asyncpg://industrial:industrial@postgres:5432/industrial_park
DATABASE_ENABLED=true
REDIS_URL=redis://redis:6379

# DeepSeek API
DEEPSEEK_API_KEY=***
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# JWT (P4: RBAC)
JWT_SECRET=change-me-to-a-random-64-char-string-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
AUTH_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-in-production

# Enterprise Data (P0)
ENTERPRISE_DATA_SOURCE=mock

# Policy RAG (P1)
POLICY_RAG_MODE=mock
POLICY_EMBEDDING_PROVIDER=deepseek
POLICY_EMBEDDING_MODEL=text-embedding-3-small
POLICY_EMBEDDING_DIMENSIONS=1536

# Streaming (P3)
STREAMING_ENABLED=true
STREAMING_HEARTBEAT_SECONDS=15

# CORS
CORS_ORIGINS=http://localhost:3000
