APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]

# Demo mode does not require PostgreSQL. Set true when DATABASE_URL is ready.
DATABASE_ENABLED=false
DATABASE_URL=postgresql+asyncpg://industrial:industrial@postgres:5432/industrial_park
REDIS_URL=redis://redis:6379/0

# Configure at least one provider for LLM-generated reports. Without a key,
# the system uses the deterministic local fallback and remains runnable.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-pro
LLM_WARMUP_ENABLED=true
LLM_VALIDATE_MODELS_ON_STARTUP=true

# Alibaba Cloud Model Studio / 百炼 embedding
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# === Enterprise Data Source (P0) ===
# local_json — 只读加载清洗后的企业快照（当前展示默认）
# mock       — 开发/演示，使用预设企业数据
# tianyancha — 天眼查商业 API
# qichacha   — 企查查开放平台
# government — 国家企业信用信息公示系统
ENTERPRISE_DATA_SOURCE=local_json
ENTERPRISE_LOCAL_JSON_PATH=data/enterprises/enterprise_import_clean.json
TIANYANCHA_API_KEY=
TIANYANCHA_BASE_URL=https://api.tianyancha.com
QICHACHA_APP_KEY=
QICHACHA_SECRET_KEY=
ENTERPRISE_CACHE_TTL=3600

# === Policy RAG (P1) ===
# mock     — Demo 模式，使用 8 条预设政策
# crawl4ai — 检索 crawl4ai-tools 同步的广州政府政策缓存
# pgvector — 生产模式，真实向量检索
POLICY_RAG_MODE=crawl4ai
POLICY_CRAWL_DATA_DIR=data/policy_snapshots
POLICY_CRAWLER_SOURCE_CONFIG=app/data/guangzhou_policy_sources.json
POLICY_CRAWLER_API_URL=http://localhost:11235
POLICY_CRAWLER_API_TOKEN=
POLICY_CRAWLER_REFRESH_DAYS=7
POLICY_EMBEDDING_PROVIDER=dashscope
POLICY_EMBEDDING_MODEL=text-embedding-v4
POLICY_EMBEDDING_DIMENSIONS=1536

AUTH_ENABLED=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
JWT_SECRET=change-this
JWT_EXPIRE_MINUTES=1440
