APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]

# Demo mode does not require PostgreSQL. Set true when DATABASE_URL is ready.
DATABASE_ENABLED=false
DATABASE_URL=postgresql+asyncpg://industrial:industrial@postgres:5432/industrial_park
REDIS_URL=redis://redis:6379/0

# Configure at least one provider for LLM-generated reports. Without a key,
# the system uses the deterministic local fallback and remains runnable.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
LLM_WARMUP_ENABLED=true

# === Enterprise Data Source (P0) ===
# mock       — 开发/演示，使用预设企业数据
# tianyancha — 天眼查商业 API
# qichacha   — 企查查开放平台
# government — 国家企业信用信息公示系统
ENTERPRISE_DATA_SOURCE=mock
TIANYANCHA_API_KEY=
TIANYANCHA_BASE_URL=https://api.tianyancha.com
QICHACHA_APP_KEY=
QICHACHA_SECRET_KEY=
ENTERPRISE_CACHE_TTL=3600

AUTH_ENABLED=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
JWT_SECRET=change-this
JWT_EXPIRE_MINUTES=1440
