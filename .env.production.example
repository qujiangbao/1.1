# Industrial Park Agent v1.3 — production configuration template
# Copy to .env.production and replace every "replace-with-" value.

APP_ENV=production
LOG_LEVEL=INFO

POSTGRES_DB=industrial_park
POSTGRES_USER=industrial
# If reusing an existing PostgreSQL volume, rotate the database role password
# first; changing this value alone does not change the password stored in PostgreSQL.
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DATABASE_ENABLED=true
DATABASE_URL=postgresql+asyncpg://industrial:replace-with-a-strong-database-password@postgres:5432/industrial_park
REDIS_URL=redis://redis:6379

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
DEEPSEEK_API_KEY=replace-with-a-real-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-pro
DASHSCOPE_API_KEY=replace-with-a-real-dashscope-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_WARMUP_ENABLED=true
LLM_VALIDATE_MODELS_ON_STARTUP=true

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
AUTH_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password

ENTERPRISE_DATA_SOURCE=local_json
ENTERPRISE_LOCAL_JSON_PATH=data/enterprises/enterprise_import_clean.json

POLICY_RAG_MODE=pgvector
POLICY_CRAWL_DATA_DIR=data/policy_snapshots
POLICY_CRAWLER_SOURCE_CONFIG=app/data/guangzhou_policy_sources.json
POLICY_CRAWLER_API_URL=http://crawl4ai:11235
POLICY_CRAWLER_API_TOKEN=${CRAWL4AI_API_TOKEN}
POLICY_CRAWLER_REFRESH_DAYS=7
POLICY_EMBEDDING_PROVIDER=dashscope
POLICY_EMBEDDING_MODEL=text-embedding-v4
POLICY_EMBEDDING_DIMENSIONS=1536

STREAMING_ENABLED=true
STREAMING_HEARTBEAT_SECONDS=15
CORS_ORIGINS=http://localhost:8080
